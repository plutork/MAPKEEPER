{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapkeeper.dev/schemas/map-rivers.schema.json",
  "title": "MAPKEEPER river catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rivers", "next_id"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "next_id": {
      "type": "integer",
      "minimum": 1
    },
    "rivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cells"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
