# Cursor at repo root — ignore except tracked agent skills (D-18)
/.cursor/*
!/.cursor/skills/
!/.cursor/skills/**

# Rust (D-20)
/target/
**/target/

# WASM build output (crates/web)
crates/web/pkg/
crates/web/dist/

