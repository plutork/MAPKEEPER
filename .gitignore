# Cursor at repo root — ignore except tracked skills + alpha commands
/.cursor/*
!/.cursor/skills/
!/.cursor/skills/**
!/.cursor/commands/
!/.cursor/commands/**

# Rust build output
/target/
**/target/

# WASM build output (crates/web)
crates/web/pkg/
crates/web/dist/

# Tauri desktop shell build output — installers are built
# artifacts, not source; `cargo tauri build` writes to target/, this is just
# a convenience copy for local testing.
/dist-installer/
crates/desktop/gen/

# Archived browser tooling may still be installed locally
tests/node_modules/
archive/map-v2/tests/node_modules/
scripts/node_modules/
scripts/.bench-npm/

# Python bytecode (scripts/, CI helpers)
**/__pycache__/
*.py[cod]
